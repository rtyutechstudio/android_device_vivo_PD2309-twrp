
on boot
    chmod 0666 /dev/vivo_haptic
    chown system system /dev/vivo_haptic
    chmod 0666 /dev/vivo_haptic_vice
    chown system system /dev/vivo_haptic_vice
    chmod 0666 /dev/vivo_haptic_core
    chown system system /dev/vivo_haptic_core

    chmod 0666 /sys/kernel/hold_actuator/hold_status
    chown system system /sys/kernel/hold_actuator/hold_status

    chmod 0666 /sys/class/leds/vibrator/reg
    chown system system /sys/class/leds/vibrator/reg



    chmod 0666 /sys/kernel/hold_actuator/hold_status
    chmod 0666 /sys/kernel/hold_actuator/hold_status1
    chmod 0666 /sys/kernel/hold_actuator/hold_status2
    chmod 0666 /sys/kernel/hold_actuator/hold_status3
    chmod 0666 /sys/kernel/hold_actuator/hold_status4
    chmod 0666 /sys/kernel/hold_actuator/hold_status5
    chmod 0666 /sys/kernel/ois0_ctrl/hold_ois
    chmod 0666 /sys/kernel/ois1_ctrl/hold_ois
    chmod 0666 /sys/kernel/ois2_ctrl/hold_ois
    chmod 0666 /sys/kernel/ois3_ctrl/hold_ois
    chown system system /sys/kernel/hold_actuator/hold_status
    chown system system /sys/kernel/hold_actuator/hold_status1
    chown system system /sys/kernel/hold_actuator/hold_status2
    chown system system /sys/kernel/hold_actuator/hold_status3
    chown system system /sys/kernel/hold_actuator/hold_status4
    chown system system /sys/kernel/hold_actuator/hold_status5
    chown system system /sys/kernel/ois0_ctrl/hold_ois
    chown system system /sys/kernel/ois1_ctrl/hold_ois
    chown system system /sys/kernel/ois2_ctrl/hold_ois
    chown system system /sys/kernel/ois3_ctrl/hold_ois
    chmod 0666 /sys/kernel/hold_actuator/read_hall_status
    chmod 0666 /sys/kernel/hold_actuator/read_hall_status1
    chmod 0666 /sys/kernel/hold_actuator/read_hall_status2
    chmod 0666 /sys/kernel/hold_actuator/read_hall_status3
    chmod 0666 /sys/kernel/hold_actuator/read_hall_status4
    chmod 0666 /sys/kernel/hold_actuator/read_hall_status5
    chmod 0666 /sys/kernel/hold_actuator/read_hall_position
    chmod 0666 /sys/kernel/hold_actuator/read_hall_position1
    chmod 0666 /sys/kernel/hold_actuator/read_hall_position2
    chmod 0666 /sys/kernel/hold_actuator/read_hall_position3
    chmod 0666 /sys/kernel/hold_actuator/read_hall_position4
    chmod 0666 /sys/kernel/hold_actuator/read_hall_position5
    chown system system /sys/kernel/hold_actuator/read_hall_status
    chown system system /sys/kernel/hold_actuator/read_hall_status1
    chown system system /sys/kernel/hold_actuator/read_hall_status2
    chown system system /sys/kernel/hold_actuator/read_hall_status3
    chown system system /sys/kernel/hold_actuator/read_hall_status4
    chown system system /sys/kernel/hold_actuator/read_hall_status5
    chown system system /sys/kernel/hold_actuator/read_hall_position
    chown system system /sys/kernel/hold_actuator/read_hall_position1
    chown system system /sys/kernel/hold_actuator/read_hall_position2
    chown system system /sys/kernel/hold_actuator/read_hall_position3
    chown system system /sys/kernel/hold_actuator/read_hall_position4
    chown system system /sys/kernel/hold_actuator/read_hall_position5

	# vivo zhaoliang add for platform begin
    chown system system /sys/class/qcom-haptics/f0_offset_10
    chmod 0777 /sys/class/qcom-haptics/f0_offset_10
    chown system system /sys/class/qcom-haptics/duration
    chmod 0777 /sys/class/qcom-haptics/duration
    chown system system /sys/class/qcom-haptics/activate
    chmod 0777 /sys/class/qcom-haptics/activate
    chown system system /sys/class/qcom-haptics/the_num_of_vibrator
    chmod 0777 /sys/class/qcom-haptics/the_num_of_vibrator
    chown system system /sys/class/qcom-haptics/is_need_cali
    chmod 0777 /sys/class/qcom-haptics/is_need_cali
    chown system system /sys/class/qcom-haptics/resis_f0
    chmod 0777 /sys/class/qcom-haptics/resis_f0
    chown system system /sys/class/qcom-haptics/cali_f0
    chmod 0777 /sys/class/qcom-haptics/cali_f0
    chown system system /sys/class/qcom-haptics/cali_f0_resis
    chmod 0777 /sys/class/qcom-haptics/cali_f0_resis
    chown system system /sys/class/qcom-haptics/iic_int_rst
    chmod 0777 /sys/class/qcom-haptics/iic_int_rst
    chown system system /sys/class/qcom-haptics/reg
    chmod 0777 /sys/class/qcom-haptics/reg
    chown system system /sys/class/qcom-haptics/reg_BOOST
    chmod 0777 /sys/class/qcom-haptics/reg_BOOST
    # vivo zhaoliang add for platform end

service vendor.vibrator-default /vendor/bin/hw/vendor.vivo.hardware.vibrator.custom.service
    class hal
    user system
    group system
    seclabel u:r:recovery:s0
    setenv RICHTAP_DEVICE_PATH  /dev/vivo_haptic;/dev/vivo_haptic_vice
    setenv ENV_RICHTAP_CONFIG_PATH /odm/etc/aac_richtap.config;/odm/etc/aac_richtap_1.config

on property:sys.boot_completed=1
    chmod 0666 /dev/vivo_haptic_core
    chown system system /dev/vivo_haptic_core
    chmod 0666 /dev/vivo_haptic
    chown system system /dev/vivo_haptic
    chmod 0666 /dev/vivo_haptic_vice
    chown system system /dev/vivo_haptic_vice
    setprop vendor.haptic.calibrate.done 1
