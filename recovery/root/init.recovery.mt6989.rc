import /init.recovery.touch.rc

on early-init
    write /sys/devices/system/cpu/cpufreq/policy0/scaling_min_freq 1200000
    write /sys/devices/system/cpu/cpufreq/policy0/scaling_max_freq 1500000
    write /sys/devices/system/cpu/cpufreq/policy4/scaling_min_freq 1500000
    write /sys/devices/system/cpu/cpufreq/policy4/scaling_max_freq 2600000
    write /sys/devices/system/cpu/cpufreq/policy7/scaling_max_freq 2700000
    write /sys/class/devfreq/mtk-dvfsrc-devfreq/userspace/set_freq 0

